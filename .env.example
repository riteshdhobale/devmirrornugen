# Copy this file to .env and set values only in your local/deployment secret store.
# Never place server-side credentials in VITE_* variables.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# GitHub analysis and App User Connector (server-only)
GITHUB_TOKEN=your_github_token
GITHUB_FINE_GRAINED_PERSONAL_ACCESS_TOKEN=your_github_fine_grained_token
GITHUB_APP_USER_CONNECTOR_CLIENT_API_KEY=your_github_connector_client_api_key
APP_USER_CONNECTION_KEY_SECRET=your_32_byte_base64_or_hex_encryption_secret

# Existing Lovable baseline gateway (server-only)
LOVABLE_API_KEY=your_lovable_api_key
LOVABLE_CRON_SECRET=your_lovable_cron_secret
LOVABLE_CRON_SECRET_PREVIOUS=your_previous_lovable_cron_secret

# Nugen developer-intelligence provider (server-only; selected explicitly by server call sites)
NUGEN_API_KEY=your_nugen_api_key
NUGEN_API_URL=https://api.nugen.in/api/v3/inference/completions
NUGEN_MODEL_ID=model_developer-intelligence-llama-v3p2-3b-reasoning-aligned_alignment_01m238qjs8r2rpe

# Paddle server credentials
PADDLE_SANDBOX_API_KEY=your_paddle_sandbox_api_key
PADDLE_LIVE_API_KEY=your_paddle_live_api_key
PAYMENTS_SANDBOX_WEBHOOK_SECRET=your_paddle_sandbox_webhook_secret
PAYMENTS_LIVE_WEBHOOK_SECRET=your_paddle_live_webhook_secret

# Paddle client token (intentionally public; Vite exposes VITE_* at build time)
VITE_PAYMENTS_CLIENT_TOKEN=your_paddle_client_token
